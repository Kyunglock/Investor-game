{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "sync": "pnpm build && cap sync android",
    "apk": "pnpm sync && cd android && ./gradlew assembleDebug --console=plain",
    "open": "cap open android",
    "assets": "node scripts/appAssets.ts && pnpm dlx @capacitor/assets generate --android --assetPath assets --iconBackgroundColor '#14161a' --iconBackgroundColorDark '#14161a' --splashBackgroundColor '#14161a' --splashBackgroundColorDark '#14161a'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "openapi-fetch": "^0.17.0",
    "phaser": "^3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
